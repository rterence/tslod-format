          "name": "block_samples",
          "note": "buckets per block; must be non-zero and a multiple of branching_factor, and defaults to it"
        },
        {
          "offset": 24,
          "width": 8,
          "type": "uint64",
          "name": "group_table_offset",
          "note": ""
        },
        {
          "offset": 32,
