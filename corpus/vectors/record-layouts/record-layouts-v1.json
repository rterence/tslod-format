      "record": "header",
      "format_version": 1,
      "struct_format": "<6sHIBBHIIQQ16sI32sQ28s",
      "size_bytes": 128,
      "byte_order": "little",
      "fields": [
        {
          "offset": 0,
          "width": 6,
          "type": "bytes",
          "name": "magic",
          "note": "b'TSLOD\\x00'"
        },
        {
          "offset": 6,
          "width": 2,
          "type": "uint16",
          "name": "version",
          "note": "1"
        },
        {
          "offset": 8,
          "width": 4,
          "type": "uint32",
          "name": "branching_factor",
          "note": ">= 2"
        },
        {
          "offset": 12,
          "width": 1,
          "type": "uint8",
          "name": "compression_id",
          "note": "v1: the file PROFILE. 0 = none (every recipe byte must be 0x00), 2 = recipe. Every other value is reserved and rejected"
        },
        {
          "offset": 13,
          "width": 1,
          "type": "uint8",
          "name": "file_state",
          "note": "0 sealed, 1 active"
        },
        {
          "offset": 14,
